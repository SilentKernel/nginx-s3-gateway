# Base version: build.sh passes the latest 1.30.x (scripts/resolve-versions.sh); the default is for
# a plain `docker build` (upstream GitHub workflow, test.sh).
ARG NGINX_VERSION=1.30.6
# Two stages: "gateway" (modules, guard, config; cached, it only changes with the nginx base) and
# "os-updates" (the day's Debian updates; never cached by build.sh, see docker-bake.hcl).
FROM nginx:${NGINX_VERSION} AS gateway

# Security floor (versions.env, passed by build.sh). Empty: no check.
ARG MIN_NGINX_VERSION=""

# Proxy cache env vars
ENV PROXY_CACHE_MAX_SIZE=10g
ENV PROXY_CACHE_INACTIVE=60m
ENV PROXY_CACHE_SLICE_SIZE=1m
ENV PROXY_CACHE_VALID_OK=1h
ENV PROXY_CACHE_VALID_NOTFOUND=1m
ENV PROXY_CACHE_VALID_FORBIDDEN=30s

# CORS env vars
ENV CORS_ENABLED=0
ENV CORS_ALLOW_PRIVATE_NETWORK_ACCESS=""

# S3 proxy env vars
ENV DIRECTORY_LISTING_PATH_PREFIX=""
ENV STRIP_LEADING_DIRECTORY_PATH=""
ENV PREFIX_LEADING_DIRECTORY_PATH=""

# We modify the NGINX base image by:
# 1. Explicitly installing the version of njs coded in the environment variable above.
# 2. Adding configuration files needed for proxying private S3 buckets.
# 3. Adding a directory for proxied objects to be stored.
# 4. Replacing the entrypoint script with a modified version that explicitly sets resolvers.

# Note: the PKG_RELEASE environment variable is inherited

# NGINX_VERSION, NJS_VERSION, NJS_RELEASE and DYNPKG_RELEASE are inherited too: the modules are pinned
# to the exact nginx of the base image (unpinned, apt takes the newest module, built for another
# nginx). Debian's updates are applied by the os-updates stage below.
RUN set -x \
    && echo "deb [signed-by=/etc/apt/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/debian/ $(echo $PKG_RELEASE | cut -f2 -d~) nginx" >> /etc/apt/sources.list.d/nginx.list \
    && apt-get update \
    && apt-get install --no-install-recommends --no-install-suggests -y \
      libedit2 \
      "nginx-module-njs=${NGINX_VERSION}+${NJS_VERSION}-${NJS_RELEASE}" \
      "nginx-module-xslt=${NGINX_VERSION}-${DYNPKG_RELEASE}" \
    && apt-get remove --purge --auto-remove -y && rm -rf /var/lib/apt/lists/*

# Refuse to produce an image older than the security floor.
RUN set -eu; \
    actual="$(nginx -v 2>&1 | sed -n 's|^nginx version: nginx/\([0-9.]*\).*|\1|p')"; \
    echo "nginx ${actual}, floor ${MIN_NGINX_VERSION:-none}"; \
    test -n "${actual}"; \
    if [ -n "${MIN_NGINX_VERSION}" ] \
        && [ "$(printf '%s\n%s\n' "${MIN_NGINX_VERSION}" "${actual}" | sort -V | head -1)" != "${MIN_NGINX_VERSION}" ]; then \
        echo "nginx ${actual} is older than ${MIN_NGINX_VERSION}: refusing to build a vulnerable image" >&2; \
        exit 1; \
    fi

COPY oss/etc/nginx /etc/nginx
COPY common/etc /etc
COPY common/docker-entrypoint.d /docker-entrypoint.d/

RUN set -x \
    && mkdir -p /var/cache/nginx/s3_proxy \
    && chown nginx:nginx /var/cache/nginx/s3_proxy \
    && find /docker-entrypoint.d -type f \( -name '*.sh' -or -name '*.envsh' \) -exec chmod -v +x {} \;

# Debian's updates of the day (security fixes first), without waiting for Docker Hub to rebuild
# nginx:${NGINX_VERSION}. Never taken from the build cache by build.sh (no-cache-filter in
# docker-bake.hcl), so only this stage (and Dockerfile.unprivileged's) runs again each night.
# Debian's archive only (debian.sources; nginx.org's nginx.list, added above, is left out): the
# upgrade never touches nginx or its modules, which stay pinned to the base image's nginx. `upgrade`,
# not `dist-upgrade`: no package added or removed; tests/os-updates.sh checks nothing is left.
FROM gateway AS os-updates
RUN set -eux; \
    debian_only="-o Dir::Etc::sourcelist=/etc/apt/sources.list.d/debian.sources -o Dir::Etc::sourceparts=-"; \
    apt-get update -o APT::Update::Error-Mode=any $debian_only; \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade -y -o Dpkg::Options::=--force-confold $debian_only; \
    rm -rf /var/lib/apt/lists/*
