# Single source of every setting of the nightly build. build.sh sources it and exports it to
# docker-bake.hcl.
#
# A series, not a version: each build resolves the latest nginx ${NGINX_SERIES}.x image published on
# Docker Hub (scripts/resolve-versions.sh), so every 1.30.x fix lands on the moving tag without
# editing this file. To build a given version instead (rollback, reproducing a build):
# NGINX_VERSION=1.30.5 ./build.sh

NGINX_SERIES=1.30

# Security floor enforced inside the image at build time (Dockerfile.oss) and by the tests.
# Raise it by hand on an nginx security release.
MIN_NGINX_VERSION=1.30.6

DEBIAN=trixie

# Production runs amd64 only.
PLATFORM=linux/amd64

# Our registry. In CI it must equal $CI_REGISTRY_IMAGE.
IMAGE=registry.developpeur-freelance.io/silent/nginx-s3-gateway-docker
# Docker Hub, pushed after our registry (same tested image). Empty: not pushed there.
DOCKERHUB_IMAGE=silentk/nginx-s3-gateway
