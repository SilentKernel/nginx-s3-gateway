# Single source of every setting of the nightly build. build.sh sources it and exports it to
# docker-bake.hcl.
#
# A series, not a version: each build starts FROM our own nginx image (../nginx-docker: nginx.org's packages,
# a drop-in for the official image, rebuilt every night), read fresh and pinned by digest
# (scripts/resolve-base.sh), so every 1.30.x fix lands on the moving tag the night after nginx-docker
# publishes it, without editing this file and without waiting for Docker Hub (until 2026-11-18 the base was
# Docker Hub's nginx:1.30.x: that day nginx 1.30.7, nine CVEs, was on nginx.org hours before the Hub).
# To build on a given nginx-docker tag instead (rollback, reproducing a build):
#   NGINX_BASE_TAG=1.30.7 ./build.sh        (or a dated one: 1.30.7-20261118)

NGINX_SERIES=1.30
NGINX_BASE_IMAGE=registry.developpeur-freelance.io/silent/nginx-docker
NGINX_BASE_TAG=1.30

# Security floor enforced inside the image at build time (Dockerfile.oss) and by the tests.
# Raise it by hand on an nginx security release.
MIN_NGINX_VERSION=1.30.7

DEBIAN=trixie

# Production runs amd64 only.
PLATFORM=linux/amd64

# Our registry. In CI it must equal $CI_REGISTRY_IMAGE.
IMAGE=registry.developpeur-freelance.io/silent/nginx-s3-gateway-docker
